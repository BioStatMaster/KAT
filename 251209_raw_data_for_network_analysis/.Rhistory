# 필요한 패키지 설치 및 로드
pkgs <- c("QUIC", "foreach", "doParallel", "stringr", "dplyr")
for (pkg in pkgs) {
if (!requireNamespace(pkg, quietly = TRUE)) install.packages(pkg)
library(pkg, character.only = TRUE)
}
#########################
#######  Packages #######
#########################
# glassoFast: QUIC의 가장 좋은 대안 (빠르고 CRAN에 있음)
need <- c("glassoFast", "foreach", "doParallel", "stringr", "dplyr")
for (pkg in need) {
if (!requireNamespace(pkg, quietly = TRUE)) install.packages(pkg)
library(pkg, character.only = TRUE)
}
#########################
####### Functions #######
#########################
# 1. 데이터 로딩 함수
load_and_process <- function(filename) {
if(!file.exists(filename)) {
warning(paste("File not found:", filename))
return(NULL)
}
rawdata <- read.csv(filename, header = TRUE, na.strings = "")
rawdata <- t(rawdata)
if(nrow(rawdata) > 56) {
rawdata <- rawdata[-c(1:56), ]
}
colnames(rawdata) <- rawdata[NROW(rawdata), ]
rawdata <- rawdata[-NROW(rawdata), ]
rawdata <- as.data.frame(rawdata)
rawdata[] <- lapply(rawdata, function(x) {
if (is.character(x) | is.factor(x)) {
suppressWarnings(as.numeric(as.character(x)))
} else x
})
return(rawdata)
}
# 2. glassoFast + EBIC 선택 함수
# QUIC 대신 glassoFast를 사용하여 고속 연산 수행
run_fast_ebic <- function(data, lambda_seq, gamma = 0.5) {
X <- scale(as.matrix(data)) # 데이터 표준화
S <- cov(X)                 # 공분산 행렬 계산
n <- nrow(X)
p <- ncol(X)
best_ebic <- Inf
best_Theta <- NULL
best_lambda <- NULL
# Lambda 시퀀스를 순회하며 최적 모델 탐색
# glassoFast는 매우 빠르므로 루프를 돌려도 금방 끝남
for (lam in lambda_seq) {
# glassoFast 실행 (QUIC 대안)
# wi가 Inverse Covariance Matrix (Precision Matrix)
fit <- glassoFast(S, rho = lam)
Theta <- fit$wi
# --- EBIC 계산 ---
# 1. Log Likelihood
# log(det(Theta)) - tr(S %*% Theta)
log_det <- tryCatch(determinant(Theta, logarithm = TRUE)$modulus[1], error = function(e) -Inf)
tr_S_Theta <- sum(diag(S %*% Theta))
log_lik <- log_det - tr_S_Theta
# 2. Edge 개수 (상삼각 행렬 0이 아닌 것)
upper_tri <- Theta[upper.tri(Theta)]
n_edges <- sum(abs(upper_tri) > 1e-5)
# 3. EBIC
ebic <- -2 * log_lik + n_edges * log(n) + 4 * n_edges * gamma * log(p)
if (ebic < best_ebic) {
best_ebic <- ebic
best_Theta <- Theta
best_lambda <- lam
}
}
colnames(best_Theta) <- rownames(best_Theta) <- colnames(data)
# 진행 상황 출력 (윈도우 병렬 처리시엔 안 보일 수 있음)
# cat(sprintf("Selected Lambda: %.4f, EBIC: %.2f\n", best_lambda, best_ebic))
return(best_Theta)
}
#########################
####### Load Data #######
#########################
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
files <- list(
bak15 = "251209_bak15_all_features.csv",
myc   = "251209_myc234_all_features.csv",
npr   = "251209_npr1_all_features.csv",
sobir = "251209_sobir1_all_features.csv",
wt_all= "251209_wt_all_features.csv"
)
data_list <- list()
for (nm in names(files)) {
data_list[[nm]] <- load_and_process(files[[nm]])
}
# Merge 데이터 처리
if(file.exists("metadata_hormone_herbivore.csv") && !is.null(data_list[["wt_all"]])) {
raw6 <- read.csv("metadata_hormone_herbivore.csv", header=T)
raw6$sample <- str_sub(raw6$sample, 1, -6)
rownames(raw6) <- raw6[,1]
raw6 <- raw6[,-c(1:7)]
raw6[] <- lapply(raw6, function(x) if(is.character(x)) as.numeric(as.character(x)) else x)
rawdata5 <- data_list[["wt_all"]]
merged <- merge(raw6, rawdata5, by="row.names")
rownames(merged) <- merged[,1]
merged <- merged[,-1]
data_list[["wt_all_with_hormone"]] <- as.data.frame(merged)
}
#############################
###### Parallel Fitting #####
#############################
# CPU 코어 수 확인 및 등록
n_cores <- parallel::detectCores() - 1
registerDoParallel(cores = n_cores)
cat("Starting Parallel fitting using glassoFast on", n_cores, "cores...\n")
# Lambda Sequence
lambda_seq <- seq(2, 0.05, length.out = 20)
# 병렬 실행
results <- foreach(nm = names(data_list), .packages = "glassoFast") %dopar% {
dat <- data_list[[nm]]
if(is.null(dat)) return(NULL)
# 함수 실행
Theta <- run_fast_ebic(dat, lambda_seq)
return(Theta)
}
