if (!is.matrix(mask) || any(dim(mask) != dim(A))) stop("mask dim mismatch.")
if (max(abs(A - t(A))) > 1e-10) stop("A must be symmetric.")
n <- nrow(A)
if (any(diag(mask) != FALSE)) stop("mask diagonal must be 1.")
L <- matrix(0, n, n)
for (i in 1:n) {
s <- if (i == 1) 0 else sum(L[i, 1:(i-1)]^2)
val <- A[i, i] - s
if (val <= tol) stop(sprintf("Non-positive pivot at i=%d (%.3e).", i, val))
L[i, i] <- sqrt(val)
if (i < n) {
for (j in (i+1):n) {
if (mask[j, i] == TRUE) {
cross <- if (i == 1) 0 else sum(L[j, 1:(i-1)] * L[i, 1:(i-1)])
L[j, i] <- (A[j, i] - cross) / L[i, i]
} else {
L[j, i] <- 0
}
}
}
}
L
}
