#########################
####### Load data #######
#########################
setwd(dirname(rstudioapi::getActiveDocumentContext()$path))
## 출력 폴더
out_dir <- "./_out"
if (!dir.exists(out_dir)) dir.create(out_dir)
## 데이터 읽기: 빈 문자열("")을 NA로 인식
annotation <- read.csv("annotated_features_DAM.csv",
header = TRUE,
na.strings = c("", "NA"))
wd
## 0) 파라미터 -----------------------------
label_cols      <- c("NPC_superclass", "NPC_class",
"ClassyFire_superclass", "ClassyFire_class")
stopifnot(all(label_cols %in% names(annotation)))
# 결과에 반드시 포함할 키들
key_feature <- if ("feature" %in% names(annotation)) "feature" else NULL
key_id_x    <- if ("id.x"     %in% names(annotation)) "id.x"   else NULL
if (is.null(key_id_x)) stop("annotation에 'id.x' 컬럼이 없습니다. (필수)")
# 레벨 가중(상위 레벨 가중↑)
w_map           <- c(NPC_superclass = 3,
NPC_class      = 2,
ClassyFire_superclass = 3,
ClassyFire_class      = 2)
unknown_factor  <- 0.2   # unknown 가중 축소
K_initial       <- 50    # 초기 모듈 수(30~80 권장)
min_size        <- 10    # 하한: 이보다 작으면 병합
max_size        <- 150   # 상한: 이보다 크면 분할
linkage_method  <- "average"  # 또는 "ward.D2"
## 1) 라벨 정리 -----------------------------
clean_label <- function(v) {
v <- trimws(as.character(v))
v[nchar(v) == 0 | is.na(v)] <- NA
v <- ifelse(is.na(v), "unknown", v)
tolower(v)
}
labels_df <- as.data.frame(lapply(annotation[label_cols], clean_label),
stringsAsFactors = FALSE)
## 2) 원-핫 인코딩 + 가중 -------------------
onehot_list <- lapply(names(labels_df), function(col){
f  <- factor(labels_df[[col]])
mm <- model.matrix(~ 0 + f)
colnames(mm) <- paste0(col, "::", levels(f))
mm
})
