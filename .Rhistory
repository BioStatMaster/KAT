## 데이터 읽기: 빈 문자열("")을 NA로 인식
annotation <- read.csv("annotated_features_DAM.csv",
header = TRUE,
na.strings = c("", "NA"))
## 사용할 라벨 컬럼 4개
label_cols <- c("NPC_superclass", "NPC_class",
"ClassyFire_superclass", "ClassyFire_class")
## 존재여부 점검
missing_cols <- setdiff(label_cols, names(annotation))
if (length(missing_cols) > 0) {
stop(paste("다음 컬럼이 파일에 없습니다:", paste(missing_cols, collapse=", ")))
}
## --- 1) 결측치 체크 -----------------------------------------------------------
## 각 라벨별 NA 개수/비율
na_summary <- data.frame(
label   = label_cols,
n_total = sapply(annotation[label_cols], function(x) length(x)),
n_na    = sapply(annotation[label_cols], function(x) sum(is.na(x))),
prop_na = sapply(annotation[label_cols], function(x) mean(is.na(x)))
)
print(na_summary)
